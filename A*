from collections import deque
import heapq
graph = {
    'S': [('H', 12), ('A', 2), ('B', 3)],
    'A': [('D', 4), ('C', 3)],
    'B': [('C', 2), ('E', 4)],
    'C': [('F', 5)],
    'D': [('F', 3), ('H', 6)],
    'E': [('F', 7), ('K', 5)],
    'F': [('G', 2)],
    'H': [('G', 15)],
    'K': [('G', 12)],
    'G': []
}

heuristic = {
    'S': 10, 'A': 7, 'B': 4, 'C': 6, 
    'D': 5, 'E': 0, 'F': 1, 'H': 10, 'K': 8, 'G': 0
}
def a_star(graph, start, goal, heuristic):
    pq = [(heuristic[start], 0, start, [start])]
    best_g = {start: 0}
    
    while pq:
        f, g, node, path = heapq.heappop(pq)
        
        if node == goal:
            return path, g
            
        for nxt, step in graph[node]:
            new_g = g + step
            if new_g < best_g.get(nxt, float('inf')):
                best_g[nxt] = new_g
                new_f = new_g + heuristic.get(nxt, 0)
                heapq.heappush(pq, (new_f, new_g, nxt, path + [nxt]))
                
    return None