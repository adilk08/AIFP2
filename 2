def bayes(prior_obstacle, p_reading_if_obstacle, p_reading_if_clear):
    score_obstacle = prior_obstacle * p_reading_if_obstacle
    score_clear = (1.0 - prior_obstacle) * p_reading_if_clear
    denominator = score_obstacle + score_clear

    if denominator == 0:
        raise ValueError("Бақылау ықтималдығы нөлге тең.")

    return score_obstacle / denominator


print("A")
print("Single BLOCKED:", f"{bayes(0.30, 0.80, 0.20):.4f}")
print("Single CLEAR:", f"{bayes(0.30, 0.20, 0.80):.4f}")

observations = ["BLOCKED", "CLEAR", "BLOCKED", "BLOCKED"]

emission = {
    "BLOCKED": (0.80, 0.20),
    "CLEAR": (0.20, 0.80),
}

p_obstacle_after = 0.30

print("\nD3")
print("t reading predicted_O updated_O updated_C")

for t, reading in enumerate(observations, start=1):
    if t == 1:
        predicted_o = p_obstacle_after
    else:
        predicted_o = (
            0.70 * p_obstacle_after
            + 0.20 * (1.0 - p_obstacle_after)
        )

    likelihood_o, likelihood_c = emission[reading]

    p_obstacle_after = bayes(
        predicted_o,
        likelihood_o,
        likelihood_c
    )

    print(
        t,
        reading,
        f"{predicted_o:.4f}",
        f"{p_obstacle_after:.4f}",
        f"{1.0 - p_obstacle_after:.4f}"
    )

print("\nD1")
for prior in [0.10, 0.30, 0.50, 0.70]:
    posterior = bayes(prior, 0.80, 0.20)
    print(f"prior={prior:.2f} posterior={posterior:.4f}")

print("\nD2")
original_emission = {
    "BLOCKED": (0.80, 0.20),
    "CLEAR": (0.20, 0.80),
}
changed_emission = {
    "BLOCKED": (0.80, 0.40),
    "CLEAR": (0.20, 0.60),
}

for name, sensor_model in [
    ("original", original_emission),
    ("changed", changed_emission)
]:
    likelihood_o, likelihood_c = sensor_model["BLOCKED"]
    posterior = bayes(0.30, likelihood_o, likelihood_c)
    print(f"{name}: {posterior:.4f}")
