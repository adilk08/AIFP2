from collections import deque
import heapq
graph = {
    'S': [('H', 12), ('A', 2), ('B', 3)],
    'A': [('D', 4), ('C', 3)],
    'B': [('C', 2), ('E', 4)],
    'C': [('F', 5)],
    'D': [('F', 3), ('H', 6)],
    'E': [('F', 7), ('K', 5)],
    'F': [('G', 2)],
    'H': [('G', 15)],
    'K': [('G', 12)],
    'G': []
}

heuristic = {
    'S': 10, 'A': 7, 'B': 4, 'C': 6, 
    'D': 5, 'E': 0, 'F': 1, 'H': 10, 'K': 8, 'G': 0
}
def ucs(graph, start, goal):
    pq = [(0, start, [start])]
    best = {start: 0}
    
    while pq:
        cost, node, path = heapq.heappop(pq)
        
        if node == goal:
            return path, cost
            
        for nxt, step in graph[node]:
            new_cost = cost + step
            if new_cost < best.get(nxt, float('inf')):
                best[nxt] = new_cost
                heapq.heappush(pq, (new_cost, nxt, path + [nxt]))
                
    return None