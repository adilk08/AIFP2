import json
import sys
from collections import defaultdict
from pathlib import Path

if hasattr(sys.stdout, "reconfigure"):
    sys.stdout.reconfigure(encoding="utf-8")

STATES = ["A", "B", "C", "D", "E", "S", "F", "H", "I"]
ACTIONS = ["UP", "DOWN", "LEFT", "RIGHT"]
TERMINALS = {"G", "X"}
POSITIONS = {
    "A": (0, 0), "B": (0, 1), "C": (0, 2), "G": (0, 3),
    "D": (1, 0), "E": (1, 2), "X": (1, 3),
    "S": (2, 0), "F": (2, 1), "H": (2, 2), "I": (2, 3),
}
STATE_AT = {position: state for state, position in POSITIONS.items()}
MOVES = {"UP": (-1, 0), "DOWN": (1, 0), "LEFT": (0, -1), "RIGHT": (0, 1)}
SIDES = {
    "UP": ("LEFT", "RIGHT"), "DOWN": ("RIGHT", "LEFT"),
    "LEFT": ("DOWN", "UP"), "RIGHT": ("UP", "DOWN"),
}


def transitions(state, action, main_prob=0.8, goal=10.0,
                danger=-10.0, step=-0.1):
    """Бұғатталған қозғалыста робот орнында қалады; бірдей нәтижелер бірігеді."""
    if state in TERMINALS:
        return [(1.0, state, 0.0)]
    side_prob = (1.0 - main_prob) / 2
    directions = [(action, main_prob)] + [(d, side_prob) for d in SIDES[action]]
    probabilities = defaultdict(float)
    row, col = POSITIONS[state]
    for direction, prob in directions:
        dr, dc = MOVES[direction]
        next_state = STATE_AT.get((row + dr, col + dc), state)
        probabilities[next_state] += prob
    result = []
    for next_state, prob in probabilities.items():
        reward = goal if next_state == "G" else danger if next_state == "X" else step
        result.append((prob, next_state, reward))
    return result


def q_value(state, action, values, gamma=0.9, **params):
    return sum(prob * (reward + gamma * values.get(next_state, 0.0))
               for prob, next_state, reward in transitions(state, action, **params))


def solve(gamma=0.9, theta=0.001, **params):
    values = dict.fromkeys(STATES, 0.0)
    history = [values.copy()]
    for iteration in range(1, 10001):
        # Барлық жаңа мән тек алдыңғы итерацияның мәндерінен есептеледі.
        new_values = {
            s: max(q_value(s, a, values, gamma, **params) for a in ACTIONS)
            for s in STATES
        }
        delta = max(abs(new_values[s] - values[s]) for s in STATES)
        values = new_values
        history.append(values.copy())
        if delta < theta:
            break
    else:
        raise RuntimeError("Итерациялар шегіне жетті")
    q_values = {s: {a: q_value(s, a, values, gamma, **params) for a in ACTIONS}
                for s in STATES}
    policy = {s: max(ACTIONS, key=lambda a: q_values[s][a]) for s in STATES}
    return {"iterations": iteration, "delta": delta, "values": values,
            "policy": policy, "q_values": q_values, "history": history}


def check_model():
    for p in (0.8, 0.6):
        for s in STATES:
            for a in ACTIONS:
                ts = transitions(s, a, main_prob=p)
                assert abs(sum(t[0] for t in ts) - 1.0) < 1e-12
                assert all(t[1] in POSITIONS and t[0] >= 0 for t in ts)
    expected = {"F": {"H": 0.8, "F": 0.2},
                "E": {"X": 0.8, "C": 0.1, "H": 0.1},
                "C": {"G": 0.8, "C": 0.1, "E": 0.1}}
    for s, target in expected.items():
        actual = {n: p for p, n, _ in transitions(s, "RIGHT")}
        assert actual.keys() == target.keys()
        assert all(abs(actual[n] - target[n]) < 1e-12 for n in target)


def main():
    check_model()
    scenarios = {
        "base": {},
        "gamma_0.2": {"gamma": 0.2},
        "main_probability_0.6": {"main_prob": 0.6},
        "danger_minus30": {"danger": -30.0},
        "step_minus1": {"step": -1.0},
    }
    results = {name: solve(**params) for name, params in scenarios.items()}
    for name, result in results.items():
        print("\nСЦЕНАРИЙ:", name)
        print("Итерация:", result["iterations"], "Delta:", result["delta"])
        for state in STATES:
            print(f"{state}: {result['values'][state]:.6f} -> {result['policy'][state]}")
    base = results["base"]
    for state in ("C", "E", "H", "I"):
        print(state, "V0/V1/V2:", [h[state] for h in base["history"][:3]])
    # Негізгі нәтиженің дәлдігін қатаңырақ тоқтату шартымен тексеру.
    accurate = solve(theta=1e-12)
    assert accurate["policy"] == base["policy"]
    assert max(abs(accurate["values"][s] - base["values"][s]) for s in STATES) < 0.001
    output = Path(__file__).with_name("results.json")
    output.write_text(json.dumps(results, ensure_ascii=False, indent=2), encoding="utf-8")
    print("\nБарлық тексеру өтті. Нәтижелер:", output.name)


if __name__ == "__main__":
    main()

 
